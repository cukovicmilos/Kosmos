# Telegram Bot Token (get from @BotFather on Telegram)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Database path
DB_PATH=kosmos.db

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Default timezone (if not available from Telegram)
DEFAULT_TIMEZONE=Europe/Belgrade

# Network timeout settings (in seconds)
TELEGRAM_CONNECT_TIMEOUT=20.0
TELEGRAM_READ_TIMEOUT=30.0
TELEGRAM_WRITE_TIMEOUT=30.0
TELEGRAM_POOL_TIMEOUT=10.0

# Admin alerts: your Telegram user ID (optional, leave empty to disable)
ADMIN_CHAT_ID=
# Consecutive Telegram polling failures before the admin is alerted
MAX_CONSECUTIVE_TIMEOUTS=3

# Reminder delivery: failed attempts before giving up (1 attempt per minute)
REMINDER_MAX_RETRIES=120
